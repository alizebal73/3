<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="AppTitle">GameNet Manager 3</sys:String>
    <sys:String x:Key="FoundationLabel">پوسته عملیاتی گیم‌نت</sys:String>
    <sys:String x:Key="FoundationReady">هسته رابط کاربری ویندوزی آماده است</sys:String>
    <sys:String x:Key="FoundationMessage">این پوسته Navigation، وضعیت اتصال، زبان، خطا، Busy و فرمان‌های سراسری را یکپارچه مدیریت می‌کند. قابلیت‌های کسب‌وکاری بعداً روی همین Foundation سوار می‌شوند.</sys:String>
    <sys:String x:Key="ArchitectureRule">سرور منبع حقیقت است؛ Desktop فقط مصرف‌کننده API سرور است؛ Agent فقط مجری محدود فرمان‌های مجاز است.</sys:String>
    <sys:String x:Key="LanguageEnglish">English</sys:String>
    <sys:String x:Key="LanguagePersian">فارسی</sys:String>
    <sys:String x:Key="Refresh">به‌روزرسانی</sys:String>
    <sys:String x:Key="ToggleLanguage">زبان</sys:String>
    <sys:String x:Key="StatusOnline">سرور متصل</sys:String>
    <sys:String x:Key="StatusConnecting">در حال اتصال...</sys:String>
    <sys:String x:Key="StatusOffline">سرور در دسترس نیست</sys:String>
    <sys:String x:Key="StatusUnknown">وضعیت نامشخص</sys:String>
    <sys:String x:Key="SelectedModule">بخش انتخاب‌شده</sys:String>
    <sys:String x:Key="FoundationContent">این بخش در Foundation فقط جایگاه و قرارداد خود را دارد. منطق کسب‌وکار بعد از Certification پایه اضافه می‌شود.</sys:String>
    <sys:String x:Key="OfflineMessage">ارتباط با Server برقرار نیست. برنامه باید بتواند پوسته را بدون خطا نمایش دهد؛ عملیات authoritative تا بازگشت اتصال قابل اجرا نیستند.</sys:String>
    <sys:String x:Key="BusyMessage">در حال دریافت وضعیت Server...</sys:String>
    <sys:String x:Key="NavHome">خانه</sys:String>
    <sys:String x:Key="NavStations">سیستم‌ها</sys:String>
    <sys:String x:Key="NavCustomers">مشتریان</sys:String>
    <sys:String x:Key="NavSessions">جلسه‌ها</sys:String>
    <sys:String x:Key="NavBilling">حساب و تسویه</sys:String>
    <sys:String x:Key="NavWallet">کیف پول</sys:String>
    <sys:String x:Key="NavInventory">انبار</sys:String>
    <sys:String x:Key="NavBuffet">بوفه</sys:String>
    <sys:String x:Key="NavTariffs">تعرفه‌ها</sys:String>
    <sys:String x:Key="NavVip">VIP</sys:String>
    <sys:String x:Key="NavReports">گزارش‌ها</sys:String>
    <sys:String x:Key="NavApprovals">تأییدها</sys:String>
    <sys:String x:Key="NavUsers">کاربران</sys:String>
    <sys:String x:Key="NavBackup">پشتیبان‌گیری</sys:String>
    <sys:String x:Key="NavAudit">ممیزی</sys:String>
    <sys:String x:Key="NavSettings">تنظیمات</sys:String>
</ResourceDictionary>
