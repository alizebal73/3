<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="AppTitle">GameNet Manager 3</sys:String>
    <sys:String x:Key="FoundationLabel">GameNet Operator Shell</sys:String>
    <sys:String x:Key="FoundationReady">Native Windows UI foundation is ready</sys:String>
    <sys:String x:Key="FoundationMessage">Navigation, connectivity, localization, error, busy and global command behavior are centralized in the UI foundation. Business features will be added on top after Foundation certification.</sys:String>
    <sys:String x:Key="ArchitectureRule">Server is authoritative. Desktop is an API client. Agent is a constrained executor of Server-authorized commands.</sys:String>
    <sys:String x:Key="LanguageEnglish">English</sys:String>
    <sys:String x:Key="LanguagePersian">فارسی</sys:String>
    <sys:String x:Key="Refresh">Refresh</sys:String>
    <sys:String x:Key="ToggleLanguage">Language</sys:String>
    <sys:String x:Key="CommandPalette">Command Palette</sys:String>
    <sys:String x:Key="CommandPaletteHint">Search sections or commands... (Ctrl+K)</sys:String>
    <sys:String x:Key="Help">Help</sys:String>
    <sys:String x:Key="HelpTitle">Shell Help</sys:String>
    <sys:String x:Key="HelpContent">Ctrl+K: open command palette and search sections. F1: show help. Esc: close overlays. Ctrl+R: refresh Server status. Ctrl+L: switch language. Ctrl+Home: return Home.</sys:String>
    <sys:String x:Key="NotificationCenter">Notifications</sys:String>
    <sys:String x:Key="NoNotifications">No active notifications.</sys:String>
    <sys:String x:Key="StatusOnline">Server online</sys:String>
    <sys:String x:Key="StatusConnecting">Connecting...</sys:String>
    <sys:String x:Key="StatusOffline">Server unavailable</sys:String>
    <sys:String x:Key="StatusUnknown">Unknown status</sys:String>
    <sys:String x:Key="SelectedModule">Selected section</sys:String>
    <sys:String x:Key="FoundationContent">This section currently contains only its Foundation placement and contracts. Business behavior will be implemented after platform certification.</sys:String>
    <sys:String x:Key="OfflineMessage">The Server is unavailable. The shell remains usable, but authoritative operations cannot execute until connectivity returns.</sys:String>
    <sys:String x:Key="BusyMessage">Refreshing Server status...</sys:String>
    <sys:String x:Key="NavHome">Home</sys:String>
    <sys:String x:Key="NavStations">Stations</sys:String>
    <sys:String x:Key="NavCustomers">Customers</sys:String>
    <sys:String x:Key="NavSessions">Sessions</sys:String>
    <sys:String x:Key="NavBilling">Billing</sys:String>
    <sys:String x:Key="NavWallet">Wallet</sys:String>
    <sys:String x:Key="NavInventory">Inventory</sys:String>
    <sys:String x:Key="NavBuffet">Buffet</sys:String>
    <sys:String x:Key="NavTariffs">Tariffs</sys:String>
    <sys:String x:Key="NavVip">VIP</sys:String>
    <sys:String x:Key="NavReports">Reports</sys:String>
    <sys:String x:Key="NavApprovals">Approvals</sys:String>
    <sys:String x:Key="NavUsers">Users</sys:String>
    <sys:String x:Key="NavBackup">Backup</sys:String>
    <sys:String x:Key="NavAudit">Audit</sys:String>
    <sys:String x:Key="NavSettings">Settings</sys:String>
</ResourceDictionary>
