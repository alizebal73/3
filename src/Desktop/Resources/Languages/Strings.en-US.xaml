<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="AppTitle">GameNet Manager 3</sys:String>
    <sys:String x:Key="FoundationLabel">Desktop Foundation</sys:String>
    <sys:String x:Key="FoundationReady">Windows desktop shell is ready</sys:String>
    <sys:String x:Key="FoundationMessage">The application is a native Windows desktop process. Business features will not be added until the platform foundation, local verification, database certification and project structure are fully approved.</sys:String>
    <sys:String x:Key="ArchitectureRule">Server is authoritative. Desktop is a client of Server APIs. No browser UI is used.</sys:String>
    <sys:String x:Key="LanguageEnglish">English</sys:String>
    <sys:String x:Key="LanguagePersian">فارسی</sys:String>
</ResourceDictionary>
