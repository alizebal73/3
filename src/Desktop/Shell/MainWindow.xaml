<Window x:Class="GameNet.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MinWidth="1180"
        MinHeight="720"
        FlowDirection="RightToLeft"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowTitle}">
    <Window.InputBindings>
        <KeyBinding Key="R"
                    Modifiers="Control"
                    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="L"
                    Modifiers="Control"
                    Command="{Binding ToggleLanguageCommand}"/>
        <KeyBinding Key="Home"
                    Modifiers="Control"
                    Command="{Binding NavigateHomeCommand}"/>
    </Window.InputBindings>

    <Grid Background="{DynamicResource BrushWindow}"
          KeyboardNavigation.TabNavigation="Local"
          Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ShellCardStyle}"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Text="{DynamicResource FoundationLabel}"/>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding WindowTitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Padding="10,6"
                            CornerRadius="8"
                            Background="{DynamicResource BrushSurfaceRaised}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding ConnectionText}"/>
                    </Border>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="{DynamicResource Refresh}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="{DynamicResource Refresh}"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="{DynamicResource ToggleLanguage}"
                            Command="{Binding ToggleLanguageCommand}"
                            AutomationProperties.Name="{DynamicResource ToggleLanguage}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource ShellCardStyle}"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="6,4,6,14">
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Text="{DynamicResource SelectedModule}"/>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentPageTitle}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationItems}"
                                      ItemTemplate="{StaticResource NavigationItemTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            AutomationProperties.HelpText="{Binding Id}">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource NavigationItemTemplate}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource ShellCardStyle}"
                    Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Text="{DynamicResource SelectedModule}"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentPageTitle}"/>

                    <Border Grid.Row="2"
                            Margin="0,20,0,0"
                            Padding="18"
                            Background="{DynamicResource BrushSurfaceRaised}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource BusyMessage}"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <StackPanel Grid.Row="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="720">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="{DynamicResource FoundationReady}"/>

                        <TextBlock Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="{DynamicResource FoundationPlaceholder}"/>

                        <Border Margin="0,22,0,0"
                                Padding="18"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushDanger}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,0"
                Background="{DynamicResource BrushSurface}">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextMuted}"
                       Text="{DynamicResource ArchitectureRule}"/>
        </Border>
    </Grid>
</Window>
