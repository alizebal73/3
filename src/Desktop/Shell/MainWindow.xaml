<Window x:Class="GameNet.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MinWidth="960"
        MinHeight="600"
        Background="#0B0F14"
        FlowDirection="RightToLeft"
        Title="{DynamicResource AppTitle}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="6,0,0,0"
                        Padding="14,8"
                        Content="{DynamicResource LanguageEnglish}"
                        Click="EnglishClick"/>
                <Button Margin="6,0,0,0"
                        Padding="14,8"
                        Content="{DynamicResource LanguagePersian}"
                        Click="PersianClick"/>
            </StackPanel>

            <StackPanel>
                <TextBlock FontSize="14"
                           Foreground="#91A0B5"
                           Text="{DynamicResource FoundationLabel}"/>
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#F5F7FA"
                           Text="{DynamicResource AppTitle}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,28"
                Padding="30"
                BorderBrush="#253040"
                BorderThickness="1"
                CornerRadius="18"
                Background="#121821">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#F5F7FA"
                           Text="{DynamicResource FoundationReady}"/>
                <TextBlock Margin="0,12,0,0"
                           MaxWidth="760"
                           FontSize="15"
                           Foreground="#B9C3D0"
                           TextWrapping="Wrap"
                           Text="{DynamicResource FoundationMessage}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#68778C"
                   FontSize="13"
                   Text="{DynamicResource ArchitectureRule}"/>
    </Grid>
</Window>
